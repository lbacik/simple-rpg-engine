{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "profile": {
        "type": "string",
        "enum": [
          "party-sentinel",
          "party-archer"
        ]
      }
    },
    "required": [
      "id",
      "name",
      "profile"
    ],
    "additionalProperties": false
  }
}
