{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "alt": {
        "type": "string"
      },
      "motion": {
        "type": "object",
        "properties": {
          "layers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "at": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                },
                "anchor": {
                  "default": {
                    "x": 50,
                    "y": 50
                  },
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                },
                "width": {
                  "default": 100,
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 400
                },
                "frames": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 64
                },
                "fps": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 30
                },
                "blend": {
                  "default": "normal",
                  "type": "string",
                  "enum": [
                    "normal",
                    "multiply",
                    "screen"
                  ]
                },
                "drift": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number",
                          "minimum": -100,
                          "maximum": 200
                        },
                        "y": {
                          "type": "number",
                          "minimum": -100,
                          "maximum": 200
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "additionalProperties": false
                    },
                    "to": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number",
                          "minimum": -100,
                          "maximum": 200
                        },
                        "y": {
                          "type": "number",
                          "minimum": -100,
                          "maximum": 200
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "additionalProperties": false
                    },
                    "duration": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 600
                    },
                    "delay": {
                      "default": 0,
                      "type": "number",
                      "minimum": 0,
                      "maximum": 600
                    },
                    "loop": {
                      "default": false,
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "from",
                    "to",
                    "duration"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "required": [
      "id",
      "path",
      "alt"
    ],
    "additionalProperties": false
  }
}
