{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "alt": {
        "type": "string"
      },
      "motion": {
        "type": "object",
        "properties": {
          "layers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "at": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                },
                "anchor": {
                  "default": {
                    "x": 50,
                    "y": 50
                  },
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                },
                "width": {
                  "default": 100,
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 400
                },
                "blend": {
                  "default": "normal",
                  "type": "string",
                  "enum": [
                    "normal",
                    "multiply",
                    "screen"
                  ]
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "required": [
      "id",
      "path",
      "alt"
    ],
    "additionalProperties": false
  }
}
