{
  "name": "simple-rpg-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "predev": "npm run migrate",
    "build": "next build --webpack",
    "start": "node scripts/start-standalone.mjs",
    "prestart": "npm run migrate",
    "validate": "tsx src/cli/validate.ts",
    "migrate": "tsx src/persistence/migrate.ts",
    "schemas": "tsx scripts/generate-schemas.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prototype:fight": "next dev --port 3011"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "kysely": "^0.29.6",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "yaml": "^2.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.64.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "^8.20.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
